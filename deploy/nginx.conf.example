# Requires valid TLS certificates, DNS and a real Basic Auth password file.
# Replace both domains and certificate paths before installing. Never expose
# ports 8780, 8781 or the optional Camofox service to the public Internet.
limit_req_zone $binary_remote_addr zone=factory_ops:10m rate=5r/s;
server {
    listen 80;
    server_name factory.your-domain.com preview.your-domain.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name factory.your-domain.com;
    ssl_certificate /etc/letsencrypt/live/factory.your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/factory.your-domain.com/privkey.pem;
    auth_basic "Private Web Factory";
    auth_basic_user_file /etc/webfactory/operators.htpasswd;
    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        limit_req zone=factory_ops burst=20 nodelay;
        proxy_pass http://127.0.0.1:8780;
        proxy_set_header Host factory.your-domain.com;
        proxy_set_header Origin $http_origin;
        proxy_read_timeout 60s;
        proxy_hide_header X-Powered-By;
    }
}
server {
    listen 443 ssl;
    server_name preview.your-domain.com;
    ssl_certificate /etc/letsencrypt/live/preview.your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/preview.your-domain.com/privkey.pem;
    auth_basic "Private Web Factory previews";
    auth_basic_user_file /etc/webfactory/operators.htpasswd;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:8781;
        proxy_set_header Host preview.your-domain.com;
        proxy_set_header Origin $http_origin;
        # Preserve the app's restrictive sandbox/CSP and read-only preview.
    }
}
