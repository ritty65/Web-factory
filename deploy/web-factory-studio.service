[Unit]
Description=Web Factory authorized private pilot queue tick
After=web-factory.service
Requires=web-factory.service

[Service]
Type=oneshot
User=webfactory
Group=webfactory
WorkingDirectory=/opt/webfactory
EnvironmentFile=/etc/webfactory/runtime.env
Environment=FACTORY_AUTORUN=0
ExecStart=/usr/bin/env node /opt/webfactory/scripts/studio-tick.mjs
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/webfactory
