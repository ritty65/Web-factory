# Non-secret example. The actual file lives outside the repository, mode 0600.
FACTORY_STATE=/var/lib/webfactory/state
FACTORY_DB=/var/lib/webfactory/state/factory.sqlite3
FACTORY_MODEL_BACKEND=codex
FACTORY_BROWSER_EXECUTABLE=/usr/bin/chromium
FACTORY_APP_ORIGIN=https://factory.your-domain.com
FACTORY_PREVIEW_ORIGIN=https://preview.your-domain.com
# Use the service user's own Codex sign-in. Do not copy this cloud task's auth.
# Optional paid-capable provider: add a restricted key securely, never in Git.
# FACTORY_GOOGLE_PLACES_KEY=
# FIRECRAWL_API_KEY=
